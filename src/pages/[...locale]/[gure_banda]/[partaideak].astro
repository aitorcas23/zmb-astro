---
import MusicianCard from "@components/MusicianCard.astro";
import Title from "@components/Title.astro";
import ContentLayout from "@layouts/ContentLayout.astro";
import * as m from "@paraglide/messages";
import { locales, baseLocale } from "@paraglide/runtime";
import { getMusicianById } from "@utils/content/musicians";
import { localizePathname } from "@utils/linking";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

export const getStaticPaths = (() => {
	return locales.map((locale) => {
		return {
			params: {
				locale: locale === baseLocale ? undefined : locale,
				gure_banda: m.gure_banda({}, { locale: locale }),
				partaideak: m.partaideak({}, { locale: locale }),
			},
			props: { locale },
		};
	});
}) satisfies GetStaticPaths;

const { locale } = Astro.props;

const musiciansOrder = (await getCollection("musiciansOrder")).pop();
const musicians = musiciansOrder
	? await Promise.all(
			musiciansOrder.data.musicians.map((musicianId) => getMusicianById(musicianId, locale)),
		).then((result) => result.filter((m) => m !== undefined))
	: [];

let translatedUrls: { [locale: string]: string } = {};
for (const tag of locales) {
	if (tag == locale) continue;
	translatedUrls[tag] = localizePathname("/gure-banda/partaideak", tag);
}
---

<ContentLayout title={m.ourBand_members_title({}, { locale: locale })} {translatedUrls} {locale}>
	<Title>{m.ourBand_members_musicians({}, { locale: locale })}</Title>
	<div class="mt-16 flex flex-wrap justify-center gap-4">
		{
			musicians.length > 0 &&
				musicians.map((musician) => {
					const { name, instrument, image, image_description } = musician.data;
					return (
						<MusicianCard
							name={name ?? ""}
							text={instrument ?? ""}
							image={image}
							alt={image_description ?? name}
						/>
					);
				})
		}
	</div>
</ContentLayout>
