---
import type { GetStaticPaths } from "astro";
import { availableLanguageTags, sourceLanguageTag } from "@paraglide/runtime";
import { idToNumber } from "@utils/content/global";
import * as t from "@paraglide/messages";
import { getNews } from "@utils/content/news";
import { localizePathname } from "@utils/linking";

export const getStaticPaths = (async () => {
	const paths = await Promise.all(
		availableLanguageTags.map(async (locale) => {
			const news = await getNews(locale);
			return news.map((n) => ({
				params: {
					locale: locale === sourceLanguageTag ? undefined : locale,
					berriak: t.berriak({}, { languageTag: locale }),
					id: idToNumber(n.id),
				},
				props: { locale, slug: n.data.slug },
			}));
		}),
	);
	return paths.flat();
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const { locale, slug } = Astro.props;
---

<meta
	http-equiv="refresh"
	content={`0;url=/${localizePathname("/berriak", locale)}/${id}/${slug}`}
/>
