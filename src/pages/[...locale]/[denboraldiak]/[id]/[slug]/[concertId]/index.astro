---
import type { GetStaticPaths } from "astro";
import { locales, baseLocale } from "@paraglide/runtime";
import { getSeasons } from "@utils/content/seasons";
import { getConcertById } from "@utils/content/concerts";
import { idToNumber } from "@utils/content/global";
import * as m from "@paraglide/messages";
import { localizePathname } from "@utils/linking";

export const getStaticPaths = (async () => {
	const paths = await Promise.all(
		locales.map(async (locale) => {
			const seasons = await getSeasons(locale);
			return (
				await Promise.all(
					seasons.map(async (season) =>
						(
							await Promise.all(
								season.data.concerts.map(async (concertId) => {
									const concert = await getConcertById(concertId, locale);
									if (concert) {
										return {
											params: {
												locale: locale === baseLocale ? undefined : locale,
												denboraldiak: m.denboraldiak({}, { locale: locale }),
												id: idToNumber(season.id),
												slug: season.data.slug,
												concertId: idToNumber(concert.id),
											},
											props: { locale, concertSlug: concert.data.slug },
										};
									}
								}),
							)
						).filter((f) => f !== undefined),
					),
				)
			).flat();
		}),
	);
	return paths.flat();
}) satisfies GetStaticPaths;

const { id, slug, concertId } = Astro.params;
const { locale, concertSlug } = Astro.props;
---

<meta
	http-equiv="refresh"
	content={`0;url=${localizePathname("/denboraldiak", locale)}/${id}/${slug}/${concertId}/${concertSlug}`}
/>
