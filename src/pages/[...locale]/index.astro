---
import type { GetStaticPaths } from "astro";
import Carousel from "@components/Carousel.astro";
import ConcertCard from "@components/ConcertCard.astro";
import HrLink from "@components/HrLink.astro";
import MediaCard from "@components/MediaCard.astro";
import NewsCard from "@components/NewsCard.astro";
import ContentLayout from "@layouts/ContentLayout.astro";
import * as m from "@paraglide/messages.js";
import { availableLanguageTags, sourceLanguageTag } from "@paraglide/runtime.js";
import { localizePathname } from "@utils/linking";
import { getNews, getNewsById } from "@utils/content/news";
import { getConcertById, getNextConcerts } from "@utils/content/concerts";
import { getSeasonByConcertId } from "@utils/content/seasons";
import { getMediaEntryById } from "@utils/content/mediaEntries";
import { idToNumber } from "@utils/content/global";
import { getCollection } from "astro:content";
import { getMediaLists } from "@utils/content/mediaLists";

export const getStaticPaths = (() => {
	return availableLanguageTags.map((locale) => {
		if (locale === sourceLanguageTag) {
			return { params: { locale: undefined }, props: { locale } };
		} else {
			return { params: { locale }, props: { locale } };
		}
	});
}) satisfies GetStaticPaths;

const { locale } = Astro.props;

// Concerts
const concerts = await getNextConcerts(locale, 4);
const seasons = await Promise.all(
	concerts.map((c) => getSeasonByConcertId(c.id.split("/")[1], locale)),
);
// News
const news = await getNews(locale, 4);
// Mediateca
const mediaList = await getMediaLists(locale, 1);
let mediaEntries = await Promise.all(
	mediaList[0].data.media_entries.map(async (entryId) => await getMediaEntryById(entryId, locale)),
)
	.then((res) => res.filter((entry) => entry !== undefined))
	.then((res) => res.slice(0, 4));
// Carousel
let slides: {
	title: string;
	image: string;
	alt: string;
	link: string;
	linkText: string;
	description?: string;
	localImage?: boolean;
}[] = [];
const carousel = (await getCollection("carousel")).pop();
if (carousel) {
	for (const concertId of carousel.data.concerts) {
		const concert = await getConcertById(concertId, locale);
		if (!concert) continue;
		const season = await getSeasonByConcertId(concertId, locale);
		if (!season) continue;
		slides.push({
			title: concert.data.title,
			image: concert.data.image ?? "/src/content/images/Logo_MusikaBanda.png",
			alt: concert.data.image_description ?? concert.data.title,
			link: `${localizePathname("/denboraldiak", locale)}/${idToNumber(season.id)}/${season.data.slug}/${idToNumber(concert.id)}/${concert.data.slug}`,
			linkText: m.home_carrousel_more({}, { languageTag: locale }),
			description: concert.data.description,
			localImage: true,
		});
	}
	for (const newsId of carousel.data.news) {
		const news = await getNewsById(newsId, locale);
		if (!news) return;
		slides.push({
			title: news.data.title,
			image: news.data.image ?? "/src/content/images/Logo_MusikaBanda.png",
			alt: news.data.image_description ?? news.data.title,
			link: `${localizePathname("/berriak", locale)}/${idToNumber(news.id)}/${news.data.slug}`,
			linkText: m.home_carrousel_read({}, { languageTag: locale }),
			description: news.data.description,
			localImage: true,
		});
	}
	for (const mediaEntryId of carousel.data.media_entries) {
		const mediaEntry = await getMediaEntryById(mediaEntryId, locale);
		if (!mediaEntry) return;
		slides.push({
			title: mediaEntry.data.title,
			image:
				mediaEntry.data.media_type === "youtube"
					? `https://img.youtube.com/vi/${mediaEntry.data.youtube_id}/maxresdefault.jpg`
					: (mediaEntry.data.image ?? "/src/content/images/Logo_MusikaBanda.png"),
			alt:
				mediaEntry.data.media_type === "youtube"
					? mediaEntry.data.title
					: (mediaEntry.data.image_description ?? mediaEntry.data.title),
			link: `${localizePathname("/mediateka/edukia", locale)}/${idToNumber(mediaEntry.id)}/${mediaEntry.data.slug}`,
			linkText: m.home_carrousel_see({}, { languageTag: locale }),
			description: mediaEntry.data.description,
			localImage: mediaEntry.data.media_type === "image",
		});
	}
}
// Translations
let translatedUrls: { [locale: string]: string } = {};
for (const tag of availableLanguageTags) {
	if (tag == locale) continue;
	translatedUrls[tag] = localizePathname("/", tag);
}
---

<ContentLayout title={m.home_title({}, { languageTag: locale })} {translatedUrls} {locale}>
	{
		slides.length > 0 && (
			<div slot="no-padding">
				<Carousel slides={slides} />
			</div>
		)
	}

	{
		// Concerts
		concerts.length > 0 && (
			<>
				<h2 class="mb-8 text-center text-3xl font-bold lg:text-4xl">
					{m.home_concerts({}, { languageTag: locale })}
				</h2>{" "}
				<div class="flex flex-wrap justify-center gap-4">
					{concerts.map((concert, i) => {
						const season = seasons[i];
						if (season) {
							return (
								<ConcertCard
									title={concert.data.title}
									description={concert.data.description}
									date={concert.data.date}
									done={concert.data.done}
									image={concert.data.image}
									alt={concert.data.image_description ?? concert.data.title}
									link={`${localizePathname("/denboraldiak", locale)}/${idToNumber(season.id)}/${
										season.data.slug
									}/${idToNumber(concert.id)}/${concert.data.slug}`}
									{locale}
								/>
							);
						}
					})}
				</div>
				<HrLink href={localizePathname("/denboraldiak", locale)} {locale} />
			</>
		)
	}

	{
		// News
		news.length > 0 && (
			<>
				<h2 class="mb-8 mt-12 text-center text-3xl font-bold lg:text-4xl">
					{m.home_news({}, { languageTag: locale })}
				</h2>
				<div class="flex flex-wrap justify-center gap-4">
					{news.map((n) => (
						<NewsCard
							title={n.data.title}
							description={n.data.description}
							date={n.data.date_created}
							image={n.data.image}
							alt={n.data.image_description ?? n.data.title}
							link={`${localizePathname("/berriak", locale)}/${idToNumber(n.id)}/${n.data.slug}`}
							{locale}
						/>
					))}
				</div>
				<HrLink href={localizePathname("/berriak", locale)} {locale} />
			</>
		)
	}

	{
		// Mediateca
		mediaEntries.length > 0 && (
			<>
				<h2 class="mb-8 mt-12 text-center text-3xl font-bold lg:text-4xl">
					{m.home_media({}, { languageTag: locale })}
				</h2>
				<div class="flex flex-wrap justify-center gap-4">
					{mediaEntries.map((me) => (
						<MediaCard
							title={me.data.title}
							description={me.data.description}
							image={
								me.data.media_type == "youtube"
									? `https://img.youtube.com/vi/${me.data.youtube_id}/hqdefault.jpg`
									: me.data.image
							}
							alt={
								me.data.media_type == "youtube"
									? me.data.title
									: (me.data.image_description ?? me.data.title)
							}
							link={`${localizePathname("/mediateka/edukia", locale)}/${idToNumber(me.id)}/${me.data.slug}`}
							localImage={me.data.media_type == "image"}
						/>
					))}
				</div>
				<HrLink href={localizePathname("/mediateka/zerrendak", locale)} {locale} />
			</>
		)
	}
</ContentLayout>
