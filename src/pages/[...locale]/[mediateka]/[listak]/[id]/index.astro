---
import type { GetStaticPaths } from "astro";
import { availableLanguageTags, sourceLanguageTag } from "@paraglide/runtime";
import { localizePathname } from "@utils/linking";
import { getMediaLists } from "@utils/content/mediaLists";
import { idToNumber } from "@utils/content/global";
import * as m from "@paraglide/messages";

export const getStaticPaths = (async () => {
	const paths = await Promise.all(
		availableLanguageTags.map(async (locale) => {
			const lists = await getMediaLists(locale);
			return lists.map((list) => ({
				params: {
					locale: locale === sourceLanguageTag ? undefined : locale,
					mediateka: m.mediateka({}, { languageTag: locale }),
					listak: m.listak({}, { languageTag: locale }),
					id: idToNumber(list.id),
				},
				props: { locale, slug: list.data.slug },
			}));
		}),
	);
	return paths.flat();
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const { locale, slug } = Astro.props;
---

<meta
	http-equiv="refresh"
	content={`0;url=${localizePathname("/mediateka/listak", locale)}/${id}/${slug}`}
/>
