---
import type { GetStaticPaths } from "astro";
import { locales, baseLocale } from "@paraglide/runtime";
import { localizePathname } from "@utils/linking";
import { getMediaEntries } from "@utils/content/mediaEntries";
import { idToNumber } from "@utils/content/global";
import * as m from "@paraglide/messages";

export const getStaticPaths = (async () => {
	const paths = await Promise.all(
		locales.map(async (locale) => {
			const entries = await getMediaEntries(locale);
			return entries.map((entry) => ({
				params: {
					locale: locale === baseLocale ? undefined : locale,
					mediateka: m.mediateka({}, { locale: locale }),
					edukia: m.edukia({}, { locale: locale }),
					id: idToNumber(entry.id),
				},
				props: { locale, slug: entry.data.slug },
			}));
		}),
	);
	return paths.flat();
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const { locale, slug } = Astro.props;
---

<meta
	http-equiv="refresh"
	content={`0;url=${localizePathname("/mediateka/entries", locale)}/${id}/${slug}`}
/>
