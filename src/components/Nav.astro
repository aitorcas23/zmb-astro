---
import LanguageSelector from "./LanguageSelector.astro";
import LinkDropdown from "./LinkDropdown.astro";
import { localizePathname } from "@utils/linking";
import * as m from "@paraglide/messages.js";
import Drawer from "./Drawer.astro";
import DrawerHamburger from "./DrawerHamburger.astro";
import { type AvailableLanguageTag } from "@paraglide/runtime";
import ZMBLogo from "@/content/images/Logo_MusikaBanda.png";
import { Image } from "astro:assets";

interface Props {
	translatedUrls: { [key: string]: string };
	locale: AvailableLanguageTag;
}
const { translatedUrls, locale } = Astro.props;

interface Link {
	text: string;
	href: string;
}

interface Dropdown {
	text: string;
	links: Link[];
	id: string;
}

type NavElements = Array<Link | Dropdown>;

const navElements: NavElements = [
	{
		text: m.ui_nav_home({}, { languageTag: locale }),
		href: localizePathname("/", locale),
	},
	{
		text: m.ui_nav_ourBand_label({}, { languageTag: locale }),
		id: "ourBand",
		links: [
			{
				text: m.ui_nav_ourBand_history({}, { languageTag: locale }),
				href: localizePathname("/gure-banda/historia", locale),
			},
			{
				text: m.ui_nav_ourBand_members({}, { languageTag: locale }),
				href: localizePathname("/gure-banda/partaideak", locale),
			},
		],
	},
	{
		text: m.ui_nav_news({}, { languageTag: locale }),
		href: localizePathname("/berriak", locale),
	},
	{
		text: m.ui_nav_season({}, { languageTag: locale }),
		href: localizePathname("/denboraldiak", locale),
	},
	{
		text: m.ui_nav_media({}, { languageTag: locale }),
		href: localizePathname("/mediateka/zerrendak", locale),
	},
	{
		text: m.ui_nav_camp({}, { languageTag: locale }),
		href: "https://www.musikaudalekuak.eus",
	},
];
---

<nav>
	<div
		class="sticky top-0 z-10 flex items-center justify-between bg-white bg-opacity-95 px-4 py-0 shadow-xl sm:px-10"
	>
		<div class="flex-shrink-0">
			<a href={localizePathname("/", locale)}>
				<Image
					src={ZMBLogo}
					alt="Logo zornotzako musica banda"
					height={200}
					class="objet-cover h-20 w-auto"
				/>
			</a>
		</div>

		<div class="hidden items-center gap-4 text-base font-semibold lg:flex">
			{
				navElements.map((elem) => {
					if ("links" in elem) {
						const dropdown = elem as Dropdown;
						return (
							<LinkDropdown
								label={dropdown.text}
								links={dropdown.links}
								id={dropdown.id}
								extraClass="transition-colors ease-out duration-150"
								hover
							/>
						);
					} else {
						const link = elem as Link;
						return (
							<a
								href={link.href}
								class="block border-0 p-2 text-gray-900 transition-colors duration-150 ease-out hover:bg-transparent hover:text-zmb"
							>
								{link.text}
							</a>
						);
					}
				})
			}

			<LanguageSelector
				translatedUrls={translatedUrls}
				{locale}
				extraClass="transition-colors ease-out duration-150"
			/>
		</div>
		<div class="lg:hidden">
			<DrawerHamburger id="nav-drawer" position="right" />
		</div>
	</div>
	<Drawer id="nav-drawer" navElements={[navElements]} position="right">
		<li>
			<LanguageSelector
				translatedUrls={translatedUrls}
				{locale}
				extraClass="transition-colors ease-out duration-150"
				acordeon
			/>
		</li>
	</Drawer>
</nav>
