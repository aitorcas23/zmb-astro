---
import { type AvailableLanguageTag } from "@paraglide/runtime";
import BookMark from "./BookMark.astro";
import News from "./icons/News.astro";
import { Image } from "astro:assets";
import { getImage } from "@utils/content/images";

interface Props {
	title: string;
	description?: string;
	date: Date;
	image?: string;
	alt?: string;
	link: string;
	locale: AvailableLanguageTag;
}

const { locale, title, description, date, image: imagePath, alt, link } = Astro.props;
const image = imagePath
	? getImage(imagePath)
	: getImage("/src/content/images/Logo_MusicaBanda.png");
---

<a
	href={link}
	class:list={[
		"relative flex max-w-[18rem] flex-col rounded-lg bg-white shadow-2xl",
		{ "ease-out-out transition-transform duration-200 hover:scale-105": link !== undefined },
	]}
	id={`link-${link}`}
>
	<figure>
		<Image
			src={image}
			alt={alt || title}
			class="aspect-video rounded-t-lg object-cover"
			width={360}
			id={`image-${link}`}
		/>
	</figure>
	<BookMark color="fill-blue-800">
		<News />
	</BookMark>
	<div class="flex flex-grow flex-col p-4">
		<h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900">
			{title}
		</h5>
		<div class="flex h-full flex-grow flex-col justify-between">
			<p class="mb-0 line-clamp-3">{description}</p>
			<small class="text-end">
				{
					date.toLocaleDateString(locale, {
						year: "numeric",
						month: "2-digit",
						day: "2-digit",
						timeZone: "UTC",
					})
				}
			</small>
		</div>
	</div>
</a>

<script is:inline define:vars={{ link }}>
	const image = document.getElementById(`image-${link}`);
	const cardLink = document.getElementById(`link-${link}`);
	cardLink.onclick = () => {
		image.setAttribute("transition:name", `transition-${link}`);
	};
</script>
