---
import { type AvailableLanguageTag } from "@paraglide/runtime";
import BookMark from "./BookMark.astro";
import CardEffect from "./CardEffect.astro";
import Music from "./icons/Music.astro";
import { Image } from "astro:assets";
import ZMBLogo from "@/content/images/Logo_MusikaBanda.png";
import { getImage } from "@utils/content/images";

interface Props {
	title: string;
	date?: Date;
	description?: string;
	image?: string;
	alt?: string;
	link: string;
	past?: boolean;
	small?: boolean;
	locale: AvailableLanguageTag;
}

const { locale, title, date, description, image, alt, link, past, small = false } = Astro.props;
const width = small ? "max-w-sm" : "max-w-lg";
---

<CardEffect href={link} extraClass={width}>
	<BookMark color="fill-zmb">
		<Music />
	</BookMark>
	<Image
		src={image ? getImage(image) : ZMBLogo}
		alt={alt || title}
		class="aspect-video w-full rounded-t-lg object-cover"
		width={small ? 416 : 544}
	/>
	<div class="p-4">
		<h5 class:list={["font-bold text-gray-900", { "text-xl": small }, { "text-2xl": !small }]}>
			{title}
		</h5>
		{
			date && (
				<p class:list={[{ "text-base": small }, { "text-lg": !small }, { "text-red-700": past }]}>
					{date.toLocaleString(locale, {
						year: "numeric",
						month: "2-digit",
						day: "2-digit",
						hour: "2-digit",
						minute: "2-digit",
						timeZone: "UTC",
					})}
				</p>
			)
		}

		<p class="mt-2 line-clamp-3">{description}</p>
	</div>
</CardEffect>
