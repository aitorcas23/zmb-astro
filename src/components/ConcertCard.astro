---
import { type Locale } from "@paraglide/runtime";
import BookMark from "./BookMark.astro";
import CardEffect from "./CardEffect.astro";
import Music from "./icons/Music.astro";
import { Image } from "astro:assets";
import ZMBLogo from "@/content/images/Logo_MusikaBanda.png";
import { getImage } from "@utils/content/images";

interface Props {
	title: string;
	date?: Date;
	description?: string;
	image?: string;
	alt?: string;
	link: string;
	done?: boolean;
	locale: Locale;
}

const { locale, title, date, description, image, alt, link, done } = Astro.props;
---

<CardEffect href={link} extraClass="max-w-[18rem]">
	<BookMark color="fill-zmb">
		<Music />
	</BookMark>
	<Image
		src={image ? getImage(image) : ZMBLogo}
		alt={alt || title}
		class="aspect-video w-full rounded-t-lg object-cover"
		width={360}
	/>
	<div class="p-4">
		<h5 class="text-xl font-bold text-gray-900">
			{title}
		</h5>
		{
			date && (
				<p class:list={["text-base", { "text-red-700": done }]}>
					{date.toLocaleString(locale, {
						year: "numeric",
						month: "2-digit",
						day: "2-digit",
						hour: "2-digit",
						minute: "2-digit",
						timeZone: "UTC",
					})}
				</p>
			)
		}

		<p class="mt-2 line-clamp-3">{description}</p>
	</div>
</CardEffect>
