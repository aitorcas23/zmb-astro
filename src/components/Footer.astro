---
import type { Locale } from "@paraglide/runtime";
import { localizePathname } from "@utils/linking";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
---

<footer class="footer mt-8 flex bg-white p-10 shadow-[0_2px_25px_-5px_rgba(0,0,0,0.3)]">
	<span class="flex-grow text-sm text-gray-900 sm:text-center"
		>© 2025 <a href={localizePathname("/", locale)} class="hover:underline"
			>Zornotzako Musika Banda</a
		>. All Rights Reserved.
	</span>
</footer>
