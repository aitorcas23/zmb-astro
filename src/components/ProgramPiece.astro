---
import type { RenderedContent } from "astro:content";

interface Props {
	piece: {
		author?: string | null;
		arranger?: string | null;
		title?: string | null;
		content_html?: RenderedContent | string | null;
		[key: string]: any;
	};
}

const { piece } = Astro.props;
let authorArranger = "";
if (piece.author && piece.arranger) {
	authorArranger = `${piece.author} | ${piece.arranger}`;
} else if (piece.author) {
	authorArranger = piece.author;
} else if (piece.arranger) {
	authorArranger = piece.arranger;
}
---

{
	(
		<div class="text-center text-lg">
			<p class="font-bold">{authorArranger}</p>
			<p class="font-normal italic">{piece.title}</p>
		</div>
	)
}
{
	piece.content_html && (
		<div
			class="format format-base mx-auto mt-16 lg:format-lg format-h1:text-center format-h1:uppercase format-li:ml-8 format-li:text-gray-900"
			set:html={piece.content_html}
		/>
	)
}
