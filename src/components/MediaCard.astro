---
import { Image } from "astro:assets";
import BookMark from "./BookMark.astro";
import CardEffect from "./CardEffect.astro";
import Media from "./icons/Media.astro";
import { getImage } from "@utils/content/images";
import ZMBLogo from "@/content/images/Logo_MusikaBanda.png";

interface Props {
	title: string;
	description?: string;
	image?: string;
	alt?: string;
	link: string;
	localImage?: boolean;
}

const { title, description, image: imagePath, alt, link, localImage = false } = Astro.props;
---

<CardEffect href={link} extraClass={"relative max-w-[18rem]"}>
	<BookMark color="fill-green-700">
		<Media />
	</BookMark>
	{
		imagePath ? (
			localImage ? (
				<Image
					src={getImage(imagePath)}
					alt={alt ?? title}
					class="aspect-video rounded-t-lg object-cover"
					width={360}
				/>
			) : (
				<Image
					src={imagePath}
					alt={alt ?? title}
					class="aspect-video rounded-t-lg object-cover"
					width={360}
					height={202}
				/>
			)
		) : (
			<Image
				src={ZMBLogo}
				alt={alt ?? title}
				class="aspect-video rounded-t-lg object-cover"
				width={360}
			/>
		)
	}
	<div class="p-4">
		<h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900">{title}</h5>

		<p class="line-clamp-3">{description}</p>
	</div>
</CardEffect>
